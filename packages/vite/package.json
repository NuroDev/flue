	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "tsdown",
		"check:types": "tsc --noEmit",
		"test": "vitest run --project unit",
		"test:integration:cloudflare": "vitest run --project cloudflare",
		"test:watch": "vitest --project unit"
	},
	"dependencies": {
		"@flue/runtime": "workspace:*",
		"@hono/node-server": "^2.0.3",
