		"vite": "^8.0.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"@earendil-works/pi-ai": "^0.87.1",
		"cf": "1.0.0-beta.14",
		"hono": "^4.12.32",
		"tsdown": "^0.22.7",
